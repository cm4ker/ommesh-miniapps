        "ru": "Приглашение в партию",
        "en": "Game invitation"
      },
      "2": {
        "ru": "Приглашение принято",
        "en": "Invitation accepted"
      },
      "3": {
        "ru": "Приглашение отклонено",
        "en": "Invitation declined"
      },
      "4": {
        "ru": "Ваш ход",
        "en": "Your turn"
      },
      "5": {
        "ru": "Событие в партии",
        "en": "Game action"
      },
      "8": {
        "ru": "Сообщение в партии",
        "en": "Game chat message"
      }
    }
  }
}
