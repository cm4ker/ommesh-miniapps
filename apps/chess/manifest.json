{
  "schema": 1,
  "id": "ommesh.chess",
  "appId": 256,
  "version": "1.4.2",
  "name": {
    "ru": "Шахматы",
    "en": "Chess"
  },
  "description": {
    "ru": "Шахматы по LoRa с подтверждением ходов (1 AES-блок на ход, двусторонний ресинк и фоновые уведомления)",
    "en": "LoRa chess with delivery ACKs (1 AES block per move, two-way resync and background notifications)"
  },
  "author": "Ommesh",
  "scope": "p2p",
  "minProtocol": 2,
  "permissions": [
    "peerData",
    "storage",
    "notifications"
  ],
  "backgroundNotices": {
    "opcodeMask": 31,
    "fallback": {
      "ru": "Событие в шахматах",
      "en": "Chess update"
    },
